# Copy to .env and fill in what you need. Both settings are optional.
# Load it with: uvicorn api.main:app --env-file .env

# Use OpenAI text-embedding-3-small instead of the offline hashing embedder.
OPENAI_API_KEY=

# Use Postgres + pgvector instead of the in-memory store (matches docker-compose.yml).
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
